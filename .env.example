TINYFISH_API_KEY=your_tinyfish_api_key_here
MOCK_MODE=true
TINYFISH_SEARCH_URL=https://api.tinyfish.com/v1/search
TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai
TINYFISH_SEARCH_METHOD=POST
TINYFISH_MAX_RESULTS=5
TINYFISH_TIMEOUT_SECONDS=30
# Web Agent (services/tinyfish_agent.py)
TINYFISH_AGENT_BASE_URL=https://agent.tinyfish.ai
TINYFISH_HTTP_TIMEOUT_SECONDS=30
TINYFISH_POLL_INTERVAL_SECONDS=2
TINYFISH_RUN_TIMEOUT_SECONDS=300
TINYFISH_MAX_ATTEMPTS=3
TINYFISH_BROWSER_PROFILE=lite
TINYFISH_MAX_DURATION_SECONDS=240
TINYFISH_USE_PROXY=false
TINYFISH_COUNTRY_CODE=US
TINYFISH_STEALTH_ESCALATION=true
TINYFISH_RETRY_BASE_SECONDS=2
TINYFISH_RETRY_CAP_SECONDS=30
TINYFISH_USER_AGENT=nexus-intel-web-agent/1.0
# Gemini 1.5 Flash extraction (never commit real keys - this file is a template)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
# FastAPI backend (app/) - placeholders only, never commit real values
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=nexus_intel
MONGODB_COLLECTION=analyses
MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=false
ANALYSIS_TIMEOUT_SECONDS=300

