# --- Runtime ---------------------------------------------------------------
MOCK_MODE=true

# --- Gemini -----------------------------------------------------------------
# Never commit real keys - this file is a template only.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- MongoDB ----------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=nexus_intel
MONGODB_COLLECTION=analyses
MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000
# Local/demo fallback: keep analyses/tracking state in process memory when
# MongoDB is down. Defaults to true when MOCK_MODE=true; resets on restart.
IN_MEMORY_PERSISTENCE=true
# Additive tracking collections (existing analysis collection is unchanged).
MONGODB_PAGE_REGISTRY_COLLECTION=page_registry
MONGODB_SNAPSHOTS_COLLECTION=page_snapshots
MONGODB_CHANGE_EVENTS_COLLECTION=change_events

# --- HTTP / CORS ------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=false
ANALYSIS_TIMEOUT_SECONDS=300

# --- Playwright -------------------------------------------------------------
# Install once: pip install -r requirements.txt && playwright install chromium
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0 Safari/537.36 nexus-intel/2.0
PLAYWRIGHT_VIEWPORT_WIDTH=1440
PLAYWRIGHT_VIEWPORT_HEIGHT=900
PLAYWRIGHT_BLOCK_RESOURCES=true
# If browser binaries are missing, static HTTP extraction can still run
# (no JavaScript). Disable to fail loudly instead.
PLAYWRIGHT_ALLOW_STATIC_FALLBACK=true
NAVIGATION_TIMEOUT_MS=30000
INTERACTION_TIMEOUT_MS=3000
PAGE_SETTLE_TIMEOUT_MS=4000

# --- Crawl / tracking -------------------------------------------------------
MAX_PAGES_PER_COMPETITOR=12
CRAWL_MAX_DEPTH=2
CRAWL_CONCURRENCY=3
CRAWL_REQUEST_TIMEOUT_SECONDS=20
CRAWL_INTERVAL_SECONDS=0.25
CRAWL_RESPECT_ROBOTS=true
MAX_INTERACTIONS=18
CAPTURE_BILLING_STATES=true
TRACKING_ENABLED=true
TRACKING_INCREMENTAL_CRAWL=true
TRACKING_INTERVAL_HOURS=12
TRACKING_STORE_FULL_SNAPSHOT=true
COLLECTION_MAX_HTML_CHARS=600000
COLLECTION_MAX_TEXT_CHARS=120000
# Tests only: never enable private targets in production.
COLLECTION_ALLOW_PRIVATE_HOSTS=false

# --- Company-name domain resolution (optional) ------------------------------
# Required only when the user supplies a company name without a website URL.
# SEARCH_PROVIDER=gemini uses Gemini Search Grounding with GEMINI_API_KEY.
# SEARCH_PROVIDER=http uses SEARCH_API_URL + SEARCH_API_KEY (Serper-compatible).
SEARCH_PROVIDER=
SEARCH_API_URL=
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5
